# Copy to .env and fill in. Only ODDS_API_KEY is required (for value betting).

# The Odds API key — free tier ~500 req/month: https://the-odds-api.com/
ODDS_API_KEY=

# Bookmaker region. "au" includes Sportsbet, TAB, Pointsbet, Neds, etc.
ODDS_API_REGION=au

# Identify yourself to Squiggle/AFL Tables (they ask scrapers to do this).
AFL_USER_AGENT=afl-predictor/0.1 (your-email@example.com)

# Optional overrides
# AFL_START_SEASON=2015
# AFL_ELO_K=24
# AFL_ELO_HGA=35
